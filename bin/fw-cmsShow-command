#!/bin/sh

# export DISPLAY=:0.0

# FW_DIR=$HOME/FireworksOnline/
# FW_LATEST_FILE=/home/viz/playback/heavyIon_2024/LatestFile
# FW_HTTP_PORT=10005

dataFile=$1;

ln -s -f ${FW_DIR}/log/cmsShow.$$.log ${FW_DIR}/log/cmsShow.log

echo "------------------------ FW_PORT $FW_PORT ======"

options=" --port $FW_HTTP_PORT -p 10 -c /home/fwdev/FireworksOnline/config/ForP5.fwc --chain 10 --live --live-path $FW_LATEST_FILE";
#options=" --port $FW_HTTP_PORT -p 10 -c /home/fwdev/FireworksOnline/config/Splashes2025.fwc --chain 10 --live --live-path $FW_LATEST_FILE";
echo "Starting cmsShowWeb.exe $options $dataFile";

set -x
export od=$PWD


export SCRAM_ARCH=el9_amd64_gcc12
. /data2/alja/cmsBld/rep/cmsset_default.sh
