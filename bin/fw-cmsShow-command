eval `scramv1 runtime -sh`

# init gdb
. /cvmfs/cms.cern.ch/el9_amd64_gcc12/external/gdb/10.2-7b0ead3835223800ef7be1b6e82aa447/etc/profile.d/init.sh

# cd $od

which cmsShowWeb.exe

k5start -q -f $HOME/private/cmsvis.kt cmsvis -- authbind cmsShowWeb.exe $options $dataFile >  ${FW_DIR}/log/cmsShow.$$.log 2>&1

